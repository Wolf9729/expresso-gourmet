# Supabase project URL (client-side publishable config)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# SERVER ONLY — do not prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Stable server-only secret, at least 32 characters. Never prefix with NEXT_PUBLIC.
PICKUP_TOKEN_SECRET=

# Optional. Leave blank in production unless explicit demo mode is needed.
NEXT_PUBLIC_DEMO_MODE=false
